# Environment configuration for When Is My Train
# Copy this file to .env or .env.local to configure real API providers or proxy backends.

# Optional backend proxy base URL (recommended for production)
# EXPO_PUBLIC_API_BASE_URL=https://your-rail-proxy.example.com

# Optional RailRadar API Key for live GPS & NTES tracking (get from railradar.in)
# EXPO_PUBLIC_RAILRADAR_API_KEY=

# Optional RapidAPI Key for IRCTC PNR status lookup
# EXPO_PUBLIC_RAPIDAPI_KEY=
